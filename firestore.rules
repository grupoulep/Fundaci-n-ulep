rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Primitives & Helpers
    // =========================================================================

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReferenceId(refId) {
      return refId is string &&
        refId.size() >= 1 &&
        refId.size() <= 30 &&
        refId.matches('^[0-9]+$');
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'grupoulep@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isListedAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() || isListedAdmin();
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================

    function isValidPaymentReference(data, referenceNumber) {
      return data.keys().hasAll([
          'referenceNumber',
          'concept',
          'amount',
          'status',
          'dueDate',
          'paymentUrl',
          'notes',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'referenceNumber',
          'concept',
          'amount',
          'status',
          'dueDate',
          'paymentUrl',
          'notes',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.referenceNumber is string &&
        data.referenceNumber == referenceNumber &&
        isValidReferenceId(data.referenceNumber) &&
        data.concept is string &&
        data.concept.size() >= 1 &&
        data.concept.size() <= 180 &&
        (data.amount is int || data.amount is float) &&
        data.amount >= 0 &&
        data.amount <= 999999999999 &&
        data.status is string &&
        data.status in ['pendiente', 'pagado', 'vencido', 'anulado'] &&
        data.dueDate is string &&
        data.dueDate.size() <= 30 &&
        data.dueDate.matches('^(|[0-9]{4}-[0-9]{2}-[0-9]{2})$') &&
        data.paymentUrl is string &&
        data.paymentUrl.size() <= 500 &&
        data.paymentUrl.matches('^(|https://.+)$') &&
        data.notes is string &&
        data.notes.size() <= 400 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.updatedBy is string &&
        data.updatedBy == request.auth.uid &&
        isValidId(data.updatedBy);
    }

    function isValidAdminAccess(data) {
      return data.keys().hasAll(['active', 'createdAt']) &&
        data.keys().hasOnly(['active', 'createdAt']) &&
        data.active is bool &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /payment_references/{referenceNumber} {
      // Exact numeric reference lookup only (no list/enumeration allowed publicly)
      allow get: if isValidReferenceId(referenceNumber);

      // Admin-only listing (O(1) auth/role check, zero public scraping)
      allow list: if isSignedIn() && isAdmin();

      // Admin-only creation with strict schema + server timestamps
      allow create: if isSignedIn() &&
        isValidReferenceId(referenceNumber) &&
        isValidPaymentReference(incoming(), referenceNumber) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      // Admin-only update with strict schema + immutable referenceNumber/createdAt
      allow update: if isSignedIn() &&
        isValidReferenceId(referenceNumber) &&
        isValidPaymentReference(incoming(), referenceNumber) &&
        incoming().referenceNumber == existing().referenceNumber &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'concept',
          'amount',
          'status',
          'dueDate',
          'paymentUrl',
          'notes',
          'updatedAt',
          'updatedBy'
        ]) &&
        isAdmin();

      // Admin-only deletion
      allow delete: if isSignedIn() &&
        isValidReferenceId(referenceNumber) &&
        isAdmin();
    }

    match /admins/{adminUid} {
      // Allow a signed-in user to read only their own admin record, or bootstrap admin to read any
      allow get: if isSignedIn() &&
        isValidId(adminUid) &&
        (request.auth.uid == adminUid || isBootstrapAdmin());

      allow list: if isBootstrapAdmin();

      allow create: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminAccess(incoming()) &&
        incoming().createdAt == request.time &&
        isBootstrapAdmin();

      allow update: if isSignedIn() &&
        isValidId(adminUid) &&
        isValidAdminAccess(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['active']) &&
        isBootstrapAdmin();

      allow delete: if isSignedIn() &&
        isValidId(adminUid) &&
        isBootstrapAdmin();
    }
  }
}
